// Original META material recipe. Linear values, no time or camera dependency.
shader meta_surface(
    vector UV = vector(0,0,0),
    color Base = color(0.15,0.12,0.1),
    int Steel = 0,
    float Detail = 0.65,
    output color Albedo = color(0),
    output float Roughness = 0.5,
    output float Height = 0.5)
{
    float x=UV[0], y=UV[1];
    float n=noise("uperlin",point(x*8,y*8,11.3));
    float fine=noise("uperlin",point(x*84,y*84,4.9));
    float d=clamp(Detail,0,1);
    if (Steel!=0) {
        float brush=noise("uperlin",point(x*19,y*230,8.1));
        float wear=smoothstep(0.49,0.76,noise("uperlin",point(x*23,y*9,18.2)));
        Albedo=Base*(1.0+d*(0.16*(brush-.5)+0.12*(wear-.5)));
        Roughness=clamp(.29+d*(.16*(brush-.5)+.16*wear),.12,.75);
        Height=clamp(.5+d*(.045*(brush-.5)+.02*(fine-.5)),0,1);
    } else {
        float fiber=noise("uperlin",point(x*130,y*85,2.1));
        Albedo=Base*(1.0+d*(.26*(n-.5)+.12*(fiber-.5)));
        Roughness=clamp(.71+d*(.16*(fine-.5)+.08*(n-.5)),.48,.95);
        Height=clamp(.5+d*(.11*(fiber-.5)+.04*(n-.5)),0,1);
    }
}
